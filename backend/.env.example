# NICC Campus Ministry backend — copy to .env and fill in real values
# NEVER commit .env to git.
PORT=5000
ADMIN_EMAIL=
ADMIN_PASSWORD=
# --- Google SMTP (Gmail) -------------------------------------------------
# Preferred: put these in the ROOT .env (repo root) so the App Password lives
# in exactly one place. backend/server.js reads GMAIL_APP_PASSWORD first and
# falls back to the EMAIL_* names below.
#   GMAIL_APP_PASSWORD = 16-char Google App Password (spaces are stripped)
#   GMAIL_USER         = the Gmail address that owns that App Password
GMAIL_APP_PASSWORD=
GMAIL_USER=
# --- Supabase (cloud database) ---------------------------------------------
# When both values are set, the backend stores users in the Supabase `users`
# table instead of the local CSV file. Leave them empty to keep using CSVs.
#   Project URL -> Dashboard > Project Settings > Data API
#   anon key    -> same page, under "API keys" (the anon/public one)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Legacy per-backend equivalents (still honoured as a fallback):
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
# When email delivery fails, the backend still advances the login to the OTP step.
# DEMO_REVEAL_OTP=true returns the code in the API response (local/dev) so you can
# keep signing in. Leave it false (or set NODE_ENV=production) and the code stays
# in the backend console only.
DEMO_REVEAL_OTP=false
# Seed row for data/admins.csv on first run: username,email,name,password
ADMINS_SEED=admin,,Admin,
