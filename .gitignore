# Logs
logs
*.log
npm-debug.log*
test-log.txt
test-err.txt
server-log.txt

# Stray PowerShell/debug output that has been accidentally redirected into files
$f
'server-run.log'

# Deps / build
node_modules
dist
dist-ssr
*.local

# Local CSV backups (may contain credentials)
*.csv.backup
*.plaintext-backup

# --- CSV database (legacy local store — never commit) --------------------
# The disciple/user records now live in Supabase. These CSVs are the old
# local store, kept only as a fallback when SUPABASE_URL/ANON_KEY are unset.
# They contain real names, emails, phone numbers and bcrypt hashes.
backend/data/*.csv
# Explicit belt-and-braces entries for the file the task calls out by name.
users.csv
**/users.csv
backend/data/visitors.csv
backend/data/admins.csv
backend/data/sign_ins.csv
backend/data/messages.csv
backend/data/feedback.csv
backend/data/announcements.csv
backend/data/verification_codes.csv
# ...but DO commit the header-only templates that document the schema.
!backend/data/templates/
!backend/data/templates/*.csv

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Private local dumps and scripts
local-only/
probe-supabase.js
upload-csv-to-supabase.js


# Env — never commit any real secrets (Gmail App Password, admin password, JWT secret)
# Covers the root .env and nested ones such as backend/.env
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
.vercel
.env*
